# Transport config for the email-mcp container (internal-only, no published port)
MCP_EMAIL_SERVER_CONFIG_PATH=/config/config.toml
MCP_HOST=0.0.0.0
MCP_PORT=8087
MCP_ALLOWED_HOSTS=email-mcp:8087,email-mcp
MCP_ALLOWED_ORIGINS=*
MCP_EMAIL_SERVER_CREDENTIAL_STORAGE=plaintext
MCP_EMAIL_SERVER_LOG_LEVEL=INFO
