# FastMCP Gateway Environment Configuration

# Server Settings
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
LOG_LEVEL=INFO
# Bearer token required on /mcp, /sse and /messages (generate with `openssl rand -hex 32`).
# Leave empty only on a trusted network: then the gateway accepts unauthenticated requests.
GATEWAY_TOKEN=

# Public hostnames, used by the Traefik routers and the workspace-mcp OAuth base URL
GATEWAY_DOMAIN=mcp.example.com
GWS_DOMAIN=gws.example.com
# Optional: client redirect URIs workspace-mcp accepts (default: localhost + mcp.local)
# WORKSPACE_MCP_ALLOWED_CLIENT_REDIRECT_URIS=http://localhost:*/callback,http://mcp.local:*/callback

# SearXNG Endpoint (reachable via traefik-proxy Docker network)
SEARXNG_URL=http://searxng:8080

# Firecrawl API (optional - leave empty or provide your API key)
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev

# Context7 API (official endpoint is https://context7.com/api)
CONTEXT7_API_KEY=
CONTEXT7_API_URL=https://context7.com/api

# Shared Brain Directory (mounted into container)
SHARED_BRAIN_PATH=/app/shared_brain

# Google Workspace (workspace-mcp sub-server)
# Set to false to run the gateway without Google tools
GOOGLE_WORKSPACE_ENABLED=true
GOOGLE_WORKSPACE_URL=https://gws.example.com/mcp

# Google Cloud OAuth credentials (see workspace-mcp/SETUP.md for the full procedure)
# 1. Create a Google Cloud project, enable Gmail/Calendar/Tasks (etc.) APIs
# 2. OAuth consent screen + OAuth Client ID (Web application)
# 3. Add redirect URI: https://gws.example.com/oauth2callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://gws.example.com/oauth2callback
# Google account the workspace tools act on
USER_GOOGLE_EMAIL=

# Home Assistant (ha-mcp sub-server): HAOS URL + long-lived access token
HOMEASSISTANT_URL=https://ha.example.com
HOMEASSISTANT_TOKEN=

# Vinted MCP sub-server bearer token (any random string, e.g. `openssl rand -hex 32`)
VINTED_MCP_TOKEN=

# Music tools (music_play / music_control): Plex + headless Plexamp first, Spotify as fallback.
# A backend stays off while its settings are empty.
PLEX_URL=http://plex:32400
PLEX_TOKEN=
# Library section id of the music library (empty = library titled Music/Musik)
PLEX_MUSIC_SECTION=
# Headless Plexamp player and the Plex server address as the PLAYER reaches it
PLEXAMP_URL=http://192.168.x.x:32500
PLEX_PLAYER_SERVER_URL=https://plex.example.com:443
MUSIC_DEFAULT_STATION=Library Radio
MUSIC_RESUME_MINUTES=30
# Spotify app (developer.spotify.com, redirect URI http://127.0.0.1:8888/callback),
# then run scripts/spotify_auth.py once
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_DEVICE=hifiberry
MUSIC_ORDER=plex,spotify
# HiFiBerryOS AudioControl, lets music_control pause/skip Bluetooth and AirPlay (empty = off)
AUDIOCONTROL_URL=
